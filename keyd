# 1 Примечания не выставляйте коментарии после команды в одну строку, иначе система воспринемает всю строку как коментарии



# [ids]  -- озночает применить для текущей клавиатуры # * -- в низу указывает что все подключаемые клавиатуры будет применять настройки конфига [ids]
[ids]
*

[main]
# обходное решение для fedora чтобы keyd не переназначал правые control и shift в качестве левого
#rightshift = rightshift
rightshift = `
` = leftmeta
#rightcontrol = rightcontrol

# тут я специально поменял правый alt на правый control чтобы сохранить такие горячие клавишу для удобного нажатия ctrl + o
rightalt = rightcontrol

compose = toggle(game)

# Если просто нажать клавишу f2 она будет работать как f2 а если зажать то специальная комбо клавиша
f2 = overload(f2, f2)
space = overload(space_modifier, space)

# переназначаем capslock на control я предпочитаю реализовать данные смену кнопок в gnome-tweak так как иногда играя в игры приходится отключать keyd чтобы space работал не в режиме layout
capslock = leftcontrol
control = capslock

[game]
# Делаем пробел обычным, полезно в случии если вы играете и пробел нужно сделать обычным 
space = space

[control]
h = left
l = right
k = up
j = down
i = C-left
o = C-right
, = home
. = end
space = space


[space_modifier:A]
# Переключение окон (уже под Альтом из-за :A, поэтому просто tab)
f = A-tab
d = A-S-tab

# Команды отмены
c = C-z
v = C-y

# Навигация по рабочим столам
w = M-pageup
e = M-pagedown

# отоброжает все открытые приложения 
r = macro(leftmeta)

# сохранения документа
s = C-s

# открытия всех приложения (важно не забудьте поменять в настройках горячих клавиш DE назначить данные клавиши)
t = macro(leftmeta+a)

# Цифры (уже с Альтом из-за :A, можно писать просто 1 = 1)
# но опять-же у меня работает если дополнительно проставить Альт
# если не работает можете проставить 1 = A-1
1 = A-1
2 = A-2
3 = A-3
4 = A-4
5 = A-5
6 = A-6
7 = A-7
8 = A-8
9 = A-9
0 = A-0

# В настройках keyboard add: добавте перемещение окон по зажатой кнопкой alt drag
g = A-f7

# смена языка
a = macro(leftshift+leftcontrol)



# перезагрузка композитора wayland (Важно понимать что на данный момент перезагрузить wayland с сохранением отkрытых окон невозможно, это возможно только на Xorg) для включение в x11 используем встроенные параметр в gnome-tweak встоенный не будет работать с wayland
[f2]
right = command(systemctl restart gdm)



[alt]
h = S-left
j = C-S-down
k = C-S-up
l = S-right
