# [ids]  -- озночает применить для текущей клавиатуры # * -- в низу указывает что все подключаемые клавиатуры будет применять настройки конфига [ids]
[ids]
*

[main]
# обходное решение для fedora чтобы keyd не переназначал правые control и shift в качестве левого
#rightshift = rightshift
rightshift = `
` = leftmeta
rightcontrol = rightcontrol

# переназначаем capslock на control
capslock = leftcontrol
control = capslock
# тут я специально поменял правый alt на правый control чтобы сохранить такие горячие клавишу для удобного нажатия ctrl + o
rightalt = rightcontrol

# Если просто нажать клавишу f2 она будет работать как f2 а если зажать то специальная комбо клавиша
f2 = overload(f2, f2)

[control]
h = left
l = right
k = up
j = down
i = C-left
o = C-right
, = home
. = end

# перезагрузка композитора wayland (Важно понимать что на данный момент перезагрузить wayland с сохранением отkрытых окон невозможно, это возможно только на Xorg) для включение в x11 используем встроенные параметр в gnome-tweak встоенный не будет работать с wayland
[f2]
right = command(systemctl restart gdm)

[alt]
h = S-left
j = C-S-down
k = C-S-up
l = S-right
